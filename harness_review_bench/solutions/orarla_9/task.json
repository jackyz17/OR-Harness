      {"source": "x_boat", "target": "Boat", "type": "produces", "evidence": "structural", "detail": ""},
      {"source": "x_train", "target": "Train", "type": "produces", "evidence": "structural", "detail": ""},
      {"source": "x_truck", "target": "Wood", "type": "consumes", "evidence": "structural", "detail": "12 units per truck"},
      {"source": "x_airplane", "target": "Wood", "type": "consumes", "evidence": "structural", "detail": "20 units per airplane"},
      {"source": "x_boat", "target": "Wood", "type": "consumes", "evidence": "structural", "detail": "15 units per boat"},
      {"source": "x_train", "target": "Wood", "type": "consumes", "evidence": "structural", "detail": "10 units per train"},
      {"source": "x_truck", "target": "Steel", "type": "consumes", "evidence": "structural", "detail": "6 units per truck"},
      {"source": "x_airplane", "target": "Steel", "type": "consumes", "evidence": "structural", "detail": "3 units per airplane"},
      {"source": "x_boat", "target": "Steel", "type": "consumes", "evidence": "structural", "detail": "5 units per boat"},
