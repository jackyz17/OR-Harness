  "family": "planning",
  "text": "Haus Toys can manufacture and sell toy trucks, toy airplanes, toy boats, and toy trains. The profit for each truck sold is $5, each airplane $10, each boat $8, and each train $7. How many types of toys should Haus Toys manufacture to maximize profits?\n\nThere are 890 units of wood available. Each truck requires 12 units, each airplane 20 units, each boat 15 units, and each train 10 units.\n\nThere are 500 units of steel available. Each airplane requires 3 units, each boat 5 units, each train 4 units, and each truck 6 units.\n\nIf Haus Toys manufactures trucks, they will not manufacture trains.\n\nHowever, if they manufacture boats, they will also manufacture airplanes.\n\nThe number of toy boats manufactured cannot exceed the number of toy trains manufactured.",
  "coupling": {
    "entities": [
      {"name": "Truck", "kind": "product", "attrs": {"profit": 5, "wood": 12, "steel": 6}},
      {"name": "Airplane", "kind": "product", "attrs": {"profit": 10, "wood": 20, "steel": 3}},
      {"name": "Boat", "kind": "product", "attrs": {"profit": 8, "wood": 15, "steel": 5}},
      {"name": "Train", "kind": "product", "attrs": {"profit": 7, "wood": 10, "steel": 4}},
      {"name": "Wood", "kind": "resource", "attrs": {"available": 890}},
      {"name": "Steel", "kind": "resource", "attrs": {"available": 500}}
    ],
    "decisions": [
      {"name": "x_truck", "kind": "production", "indexes": [], "attrs": {"desc": "number of trucks manufactured", "domain": "nonnegative_integer"}},
      {"name": "x_airplane", "kind": "production", "indexes": [], "attrs": {"desc": "number of airplanes manufactured", "domain": "nonnegative_integer"}},
      {"name": "x_boat", "kind": "production", "indexes": [], "attrs": {"desc": "number of boats manufactured", "domain": "nonnegative_integer"}},
      {"name": "x_train", "kind": "production", "indexes": [], "attrs": {"desc": "number of trains manufactured", "domain": "nonnegative_integer"}}
    ],
    "constraints": [
      {"id": "wood_limit", "kind": "resource", "expr": "12*x_truck + 20*x_airplane + 15*x_boat + 10*x_train <= 890"},
      {"id": "steel_limit", "kind": "resource", "expr": "6*x_truck + 3*x_airplane + 5*x_boat + 4*x_train <= 500"},
      {"id": "no_truck_train", "kind": "conditional", "expr": "x_truck + x_train <= 0", "note": "if trucks>0 then trains=0; needs big-M: x_truck <= M*y, x_train <= M*(1-y)"},
      {"id": "boat_requires_airplane", "kind": "conditional", "expr": "x_boat <= x_airplane"},
      {"id": "boat_le_train", "kind": "comparison", "expr": "x_boat <= x_train"}
    ],
    "relations": [
